# Port server API/produksi (dev: Vite di :3000 mem-proxy /api ke port ini)
PORT=3001

# URL publik aplikasi. Dipakai untuk membentuk tautan di QR laboratorium
# (contoh: https://rejasa.example.sch.id). Jika kosong, dipakai origin dari request.
APP_URL=

# Lokasi file database SQLite
DB_PATH=./data/rejasa.db

# Isi data demo (jurnal & insiden contoh) saat database pertama kali dibuat.
# Set "false" untuk produksi.
SEED_DEMO_DATA=true

# Batas percobaan login per IP per menit (default 10). Naikkan hanya untuk pengujian otomatis.
LOGIN_RATE_LIMIT=10
